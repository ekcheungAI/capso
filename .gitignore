.pnpm-store/

# builds
.next/
out/
dist/
apps/mac/src-tauri/target/

# env / secrets — never commit
.env
.env.local
.env.*.local

# generated extension build
apps/web/public/capso-extension.zip
apps/web/public/extension-version.json

# generated brand renders — images stay out of git.
# Glob, not a list: a `renders-styles/` folder appeared that matched none of the
# three enumerated rules and 22 MB of PNGs went in before anyone noticed.
drafts/brand/renders*/

# generated preview bundles — same failure mode as renders: a 128 MB
# `*-interactive-preview/` dir appeared outside the renders glob.
drafts/*preview*/

# QA evidence, browser-tool scratch, and CLI temp state — artifacts, not source
.playwright-cli/
qa/
output/
supabase/.temp/

# npm artifact in a pnpm repo — a stray `npm install` creates this
package-lock.json

# tooling
__pycache__/
.DS_Store
*.log
.vercel/
coverage/
.vercel

# Playwright run artifacts
test-results/
playwright-report/
