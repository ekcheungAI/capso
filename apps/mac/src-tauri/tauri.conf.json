{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capso",
  "version": "0.1.0",
  "identifier": "com.capso.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capso Settings",
        "width": 620,
        "height": 540,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "history",
        "title": "Capture History — Capso",
        "url": "index.html?surface=history",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture-hud",
        "title": "Capture — Capso",
        "url": "index.html?surface=capture-hud",
        "width": 460,
        "height": 360,
        "minWidth": 392,
        "minHeight": 328,
        "maxWidth": 560,
        "maxHeight": 460,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "recording-studio",
        "title": "Screen Recording — Capso",
        "url": "index.html?surface=recording",
        "width": 480,
        "height": 520,
        "minWidth": 440,
        "minHeight": 440,
        "maxWidth": 620,
        "maxHeight": 680,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "contentProtected": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture-overlay",
        "title": "Capso capture",
        "url": "index.html?surface=overlay",
        "width": 304,
        "height": 194,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "area-selector",
        "title": "Select Area — Capso",
        "url": "index.html?surface=area-selector",
        "width": 1440,
        "height": 900,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "freeze-screen",
        "title": "Freeze Screen — Capso",
        "url": "index.html?surface=freeze",
        "width": 1440,
        "height": 900,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture-timer",
        "title": "Capture timer — Capso",
        "url": "index.html?surface=timer",
        "width": 296,
        "height": 70,
        "visible": false,
        "focus": false,
        "focusable": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      },
      {
        "label": "annotation-editor",
        "title": "Annotate — Capso",
        "url": "index.html?surface=annotate",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "focus": true,
        "focusable": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/captures/**", "$APPDATA/freeze/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["capso"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["capso"]
      }
    }
  }
}
