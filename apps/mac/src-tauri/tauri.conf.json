{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capso",
  "version": "0.1.0",
  "identifier": "com.capso.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capso",
        "width": 360,
        "height": 620,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "capture-overlay",
        "title": "Capso capture",
        "url": "index.html?surface=overlay",
        "width": 252,
        "height": 194,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/captures/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
