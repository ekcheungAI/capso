{
  "manifest_version": 3,
  "name": "Capso",
  "version": "0.5.0",
  "description": "Capture a browser view, page element, selected area, or full page into Capso.",
  "permissions": ["activeTab", "scripting", "storage", "notifications", "alarms", "unlimitedStorage"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "capture-tab": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Capture the visible tab"
    },
    "capture-area": {
      "description": "Select an area of the active page"
    },
    "capture-element": {
      "description": "Select a page element or drag a free area"
    },
    "capture-full-page": {
      "description": "Capture the full scrollable page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
