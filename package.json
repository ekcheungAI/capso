{
  "name": "capso",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mac": "pnpm --filter mac tauri dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm brand:check && pnpm capture:check && pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build:extension": "bash scripts/build-extension.sh",
    "brand:tokens": "node scripts/gen-tokens.mjs",
    "brand:check": "node scripts/gen-tokens.mjs --check",
    "capture:spec": "node --experimental-strip-types scripts/gen-capture-spec.mjs",
    "capture:check": "node --experimental-strip-types scripts/gen-capture-spec.mjs --check",
    "loop:check": "node scripts/validate-capso-loop.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
