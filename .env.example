# Copy to .env.local (gitignored). Never commit real values.

# --- Supabase (both apps) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public values embedded into the native binary at build time. The Rust build
# rejects secret/service-role keys before compiling the app.
CAPSO_SUPABASE_URL=
CAPSO_SUPABASE_PUBLISHABLE_KEY=
# server-only, Edge Functions / worker
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server-only, see 09_AI_SYSTEM_AND_MODEL_ROUTING.md) ---
# MiniMax coding-plan key (sk-cp-...), served on the Anthropic-compatible endpoint.
# Without it the app still runs and falls back to sample classifications.
MINIMAX_TEXT_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M3
EMBEDDINGS_API_KEY=

# --- Telemetry (P0 task: init only) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
